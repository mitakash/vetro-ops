# Primary keyed Ethereum RPC. Server-only. Tried first for every Ethereum read.
# Gateway eth_getLogs prefers this URL because it serves ranges older than the
# public node. Never commit a real URL. Never log it. Never expose it to the browser.
INFURA_RPC_URL=

# Fallback Ethereum RPC, used when Infura is unset or a call fails.
# When unset, the server uses https://ethereum-rpc.publicnode.com, which refuses
# eth_getLogs older than about 12,000 blocks. Never commit a keyed URL.
# Never log it. Never expose it to the browser.
ETH_RPC_URL=

# Optional HTTPS Hemi RPC. When unset, the server uses the public Hemi mainnet
# endpoint below (chain 43111, about 300 requests per minute, not a secret).
# Never log it. Never expose it to the browser.
HEMI_RPC_URL=https://rpc.hemi.network/rpc

# Keeper that holds VUSD and DISTRIBUTOR_ROLE. Used to preview balances. Not a secret.
KEEPER_ADDRESS=

# 0x-prefixed 32-byte key. Set only in the host environment (Vercel Sensitive env).
# Ignored unless ACTIONS_ENABLED=true. Never commit this.
KEEPER_PRIVATE_KEY=

# Kept for older keeper tooling. The public monitor never broadcasts, even when this is true.
ACTIONS_ENABLED=false

# Absolute peg deviation, in basis points, that raises the dashboard banner.
PEG_ALERT_BPS=50

# Largest VUSD amount the drip route will encode or send.
DRIP_MAX_VUSD=1000000

# Required for /api/cron/status. The route fails closed when this is unset.
# Vercel sends it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
